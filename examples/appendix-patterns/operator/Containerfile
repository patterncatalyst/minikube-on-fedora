# shipping-policy-operator Containerfile, multi-stage: a Go builder stage
# produces one static binary, a ubi10/ubi-micro runtime stage carries nothing
# else. No shell, no package manager, no CGO, in the final image.
#
# Build and load onto the mof-patterns minikube profile:
#   docker build -t shipping-policy-operator:v1 -f Containerfile .
#   minikube -p mof-patterns image load shipping-policy-operator:v1
# (see README.md for the full walkthrough and a build-and-load one-liner).

# ─── Builder ──────────────────────────────────────────────────────────────
FROM docker.io/library/golang:1.26 AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY api/ ./api/
COPY cmd/ ./cmd/
COPY internal/ ./internal/

# CGO_ENABLED=0 for a fully static binary ubi-micro (no libc) can run.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /build/manager ./cmd

# ─── Runtime ──────────────────────────────────────────────────────────────
FROM registry.access.redhat.com/ubi10/ubi-micro:10.2

COPY --from=builder --chown=1001:0 /build/manager /manager

USER 1001:0

ENTRYPOINT ["/manager"]
